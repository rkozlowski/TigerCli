<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ItTiger.TigerCli.PngSink</PackageId>
    <Description>Deterministic PNG rendering sink for TigerCli output, documentation artifacts, examples, and visual review.</Description>
    <PackageTags>TigerCli;PNG;CLI;TUI;terminal;documentation;rendering</PackageTags>
    <PackageIcon>TigerCli.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ItTiger.TigerCli.PngSink.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItTiger.TigerCli\ItTiger.TigerCli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\docs\assets\TigerCli.png" Pack="true" PackagePath="\" Link="TigerCli.png" />
    <EmbeddedResource Include="Assets\*.png" />
    <EmbeddedResource Include="Fonts\*.ttf" />
    <None Update="Assets\*.png" Pack="true" PackagePath="assets\%(Filename)%(Extension)" />
    <None Include="Fonts\OFL.txt" Pack="true" PackagePath="fonts\OFL.txt" />
    <None Include="Fonts\CASCADIA-LICENSE.txt" Pack="true" PackagePath="fonts\CASCADIA-LICENSE.txt" />
    <None Include="Fonts\SOURCE.md" Pack="true" PackagePath="fonts\SOURCE.md" />
  </ItemGroup>

</Project>
